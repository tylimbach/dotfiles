#!/usr/bin/env python3
"""zw: one zellij tab per git worktree, each with its own agent.

Worktrees live next to the main checkout as ../<repo>-NAME on branch
agent/NAME, branched from the checkout zw runs in, which becomes the branch's
upstream (its "base"), so a story's worktree can branch its own tasks.
Inside zellij, each gets a tab named NAME running the agent, with a
hidden floating shell in the worktree (Alt+w).

A repo can keep a pool instead (`git config zw.pool N`): worktrees at
../<repo>-pool-K, reused, so a task starts from the last one's build.
`add` switches an idle one (detached, clean) to agent/NAME, else makes
another; `done` detaches it and deletes the branch, keeping its files,
and removes it only past N idle. A pooled worktree holds many tasks'
agent sessions, so `new NAME -c` resumes the latest one on agent/NAME.

  zw new NAME [--codex] [ARGS...]  worktree + tab + agent (ARGS go to the agent);
                                   an existing NAME gets its tab back, or a new one
                                   in its worktree (`zw new NAME -c` resumes there)
  zw add NAME                      worktree only
  zw path NAME                     NAME's worktree directory
  zw go NAME                       focus NAME's tab
  zw ls                            worktrees: branch, commits ahead, uncommitted files
  zw land [CHECK...]               from a worktree: rebase onto its base,
                                   run CHECK (e.g. `just check`), fast-forward it
  zw done NAME [--checked]         once landed: close the tab, remove worktree and branch
                                   (--checked: the caller checked it landed, e.g. by patch)
  zw sync NAME                     an agent already in tab NAME, quit by the person:
                                   resumed in a fresh tab, with Orca's view (below)
  zw status working|input|done|clear
                                   agent hooks: mark this pane's tab name

With Orca (onorca.dev) running, `new` and `sync` also open the tab in Orca:
a terminal Orca opens in the worktree opens the zellij tab and attaches to
the session, so Orca's tab and zellij's are two views of one agent. Orca
hears of an agent only through its hooks, which report for the Orca pane
named in the agent's environment, so the agent starts with that terminal's
identity (IDENTITY; never the hooks' token, which they reread from the
endpoint file). `done` closes Orca's views too. Without Orca, nothing
changes; with Orca installed but unreachable, zw says why. Setup:
orca/README.md.
"""
import glob
import itertools
import json
import os
import re
import shlex
import shutil
import subprocess
import sys

MARKS = {"working": "●", "input": "?", "done": "✓", "clear": ""}
MARK_RE = re.compile(r" [●?✓]$")
# On Linux `orca` is usually the GNOME screen reader; Orca's CLI is `orca-ide`.
# Its install path too: a zellij pane keeps its server's PATH, maybe from before
# Orca put its CLI there.
ORCA = (shutil.which("orca-ide" if sys.platform == "linux" else "orca")
        or (os.path.join(os.environ.get("LOCALAPPDATA", ""), "Programs", "orca", "resources",
                         "bin", "orca.exe") if os.name == "nt"
            else "/Applications/Orca.app/Contents/Resources/bin/orca"))
NO_ORCA = "Orca isn't installed"
# What an agent needs for Orca's hooks to report for an Orca pane. Codex's
# hook runs only with the port set; the port is no secret.
IDENTITY = ["ORCA_PANE_KEY", "ORCA_TAB_ID", "ORCA_WORKTREE_ID", "ORCA_AGENT_HOOK_ENDPOINT",
            "ORCA_AGENT_HOOK_PORT", "ORCA_AGENT_HOOK_ENV", "ORCA_AGENT_HOOK_VERSION",
            "ORCA_AGENT_HOOK_TRANSPORT"]
AGENTS = ("claude", "codex")
# Codex otherwise hands turns to a shared background server, which runs the
# hooks in its own environment: neither zellij's pane nor Orca's identity
# reaches them, so no tab marks and no Orca status. Orca adds it too.
CODEX_FLAGS = ("--no-daemon",)
# Claude's flags a resumed session keeps; the rest of its command was the brief.
KEPT_FLAGS = ("--model", "--effort")


def git(*args, cwd=None):
    out = subprocess.run(["git", *args], cwd=cwd, capture_output=True, encoding="utf-8")
    return out.stdout.rstrip() if out.returncode == 0 else ""


def run(*args, cwd=None):
    return subprocess.run(list(args), cwd=cwd).returncode == 0


def session():
    """The zellij session zw drives, or None: this pane's, else the one named
    for the repo's main checkout, so zw works from outside zellij too (an Orca
    terminal). A renamed session keeps its old name in ZELLIJ_SESSION_NAME,
    and actions sent there hang."""
    out = subprocess.run(["zellij", "list-sessions", "--no-formatting"],
                         capture_output=True, encoding="utf-8").stdout
    alive = {line.split()[0] for line in out.splitlines() if line and "EXITED" not in line}
    if os.environ.get("ZELLIJ_SESSION_NAME") in alive:
        return os.environ["ZELLIJ_SESSION_NAME"]
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    repo = os.path.basename(os.path.dirname(common)) if common else None
    return repo if repo in alive else None


def zellij(*args, capture=False, name=None):
    """A zellij action in session NAME (by default zw's), or None without one."""
    name = name or session()
    if name is None:
        return None
    try:
        out = subprocess.run(["zellij", "--session", name, "action", *args], capture_output=True,
                             encoding="utf-8", timeout=3, stdin=subprocess.DEVNULL)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None
    if out.returncode != 0:
        return None
    return out.stdout if capture else ""


def tabs():
    out = zellij("list-tabs", "--json", capture=True)
    return json.loads(out) if out else []


def tab_id(name):
    return next((t["tab_id"] for t in tabs() if MARK_RE.sub("", t["name"]) == name), None)


def go(name):
    tid = tab_id(name)
    return tid is not None and zellij("go-to-tab-by-id", str(tid)) is not None


def worktrees():
    """(path, branch) of every worktree, the main checkout first."""
    found, path = [], None
    for line in git("worktree", "list", "--porcelain").splitlines():
        if line.startswith("worktree "):
            path = line[len("worktree "):]
        elif line.startswith("branch ") and path:
            found.append((path, line[len("branch refs/heads/"):]))
        elif line == "detached" and path:
            found.append((path, "(detached)"))
    if not found:
        sys.exit("Not in a git repository.")
    return found


def target(name):
    """NAME's worktree and branch: an existing one, zw's (agent/NAME) or
    Claude Code's (worktree-NAME, under .claude/worktrees), else where zw
    makes it."""
    trees = worktrees()
    main = trees[0][0]
    folder = f"{os.path.basename(main)}-{name}"
    for path, branch in trees[1:]:
        if (name == branch or os.path.basename(path) in (name, folder)
                or branch in (f"agent/{name}", f"worktree-{name}")):
            return path, branch
    return os.path.join(os.path.dirname(main), folder), f"agent/{name}"


def base(branch, cwd=None):
    """The local branch BRANCH lands into: its upstream, else the main
    checkout's branch (worktrees made before zw recorded one)."""
    ref = git("for-each-ref", "--format=%(upstream)", f"refs/heads/{branch}", cwd=cwd)
    return ref[len("refs/heads/"):] if ref.startswith("refs/heads/") else worktrees()[0][1]


def pool_size(main):
    """How many idle worktrees the repo keeps (`git config zw.pool N`); 0 by
    default: a worktree per task, removed when done."""
    value = git("config", "--get", "zw.pool", cwd=main)
    return int(value) if value.isdigit() else 0


def pooled(path, main):
    return re.fullmatch(re.escape(os.path.basename(main)) + r"-pool-\d+",
                        os.path.basename(path)) is not None


def idle(trees, main):
    """Pooled worktrees no task holds: detached and clean."""
    return [path for path, branch in trees[1:] if pooled(path, main)
            and branch == "(detached)" and not git("status", "--porcelain", cwd=path)]


def add(name):
    trees = worktrees()
    main = trees[0][0]
    path, branch = target(name)
    if os.path.isdir(path):
        return path
    here = git("branch", "--show-current") or trees[0][1]
    free = idle(trees, main) if pool_size(main) else []
    if free:
        path = free[0]
        if not run("git", "switch", "-q", "-c", branch, here, cwd=path):
            sys.exit(1)
    else:
        if pool_size(main):
            taken = {os.path.basename(p) for p, _ in trees}
            slot = next(f"{os.path.basename(main)}-pool-{k}" for k in itertools.count(1)
                        if f"{os.path.basename(main)}-pool-{k}" not in taken)
            path = os.path.join(os.path.dirname(main), slot)
        if not run("git", "worktree", "add", "-b", branch, path, here, cwd=main):
            sys.exit(1)
    git("branch", f"--set-upstream-to={here}", branch, cwd=main)
    print(f"{branch} from {here}, in {path}", flush=True)
    return path


def session_of(path, branch):
    """The latest Claude Code session in PATH on BRANCH, or None: its
    transcripts sit in a folder named for the directory, and each message
    records the branch it ran on."""
    folder = os.path.join(os.path.expanduser("~/.claude/projects"),
                          re.sub(r"[^A-Za-z0-9-]", "-", path))
    for transcript in sorted(glob.glob(os.path.join(folder, "*.jsonl")),
                             key=os.path.getmtime, reverse=True):
        with open(transcript, encoding="utf-8", errors="replace") as f:
            if any(f'"gitBranch":"{branch}"' in line.replace(" ", "") for line in f):
                return os.path.basename(transcript)[:-len(".jsonl")]
    return None


def attached():
    """Exit unless zw has a zellij session to drive."""
    if session() is None:
        sys.exit(f"No zellij session: this pane's ({os.environ.get('ZELLIJ_SESSION_NAME')!r}) "
                 "isn't running (renamed since it opened?), and none is named for the repo.")


def new(name, args):
    path = add(name)
    attached()
    if go(name):
        return
    if pooled(path, worktrees()[0][0]) and ("-c" in args or "--continue" in args):
        # The directory's latest session may be an earlier task's.
        session = session_of(path, target(name)[1])
        args = [a for a in args if a not in ("-c", "--continue")]
        args = ["--resume", session, *args] if session else args
    agent = (["codex", *CODEX_FLAGS, *[a for a in args if a != "--codex"]] if "--codex" in args
             else ["claude", *args])
    open_views(name, path, agent)


def orca_unreachable():
    """Why Orca can't be reached, or None when it can. A running Orca can
    look absent: a sandboxed shell can't open its socket, and the PATH link
    its settings install can be one the user can't resolve."""
    if not os.path.exists(ORCA):
        return NO_ORCA
    reply = subprocess.run([ORCA, "status", "--json"], capture_output=True, encoding="utf-8")
    try:
        if json.loads(reply.stdout)["result"]["runtime"]["reachable"]:
            return None
    except (ValueError, KeyError, TypeError):
        pass
    said = (reply.stdout + reply.stderr).strip().splitlines()
    return f"`orca status` says {said[-1]!r}" if said else "`orca status` said nothing"


def open_views(name, path, agent, replace=None):
    """Tab NAME running AGENT in PATH (in place of tab id REPLACE), and with
    Orca, Orca's terminal in PATH viewing it: that terminal opens the tab
    (`zw view`), so the agent gets its identity."""
    problem = orca_unreachable()
    if problem is None:
        view = [sys.executable, os.path.realpath(__file__), "view", session(), name, path]
        view += [replace] if replace else []
        # The command is quoted for a POSIX shell; Windows terminals default
        # to PowerShell.
        shell = ["--shell", "git-bash"] if os.name == "nt" else []
        if run(ORCA, "terminal", "create", "--worktree", f"path:{path}", "--title", name, *shell,
               "--command", shlex.join([*view, "--", *agent])):
            return
        problem = "`orca terminal create` failed"
    if problem != NO_ORCA:
        print(f"No Orca view for {name}: {problem}. The zellij tab alone; once Orca is "
              f"reachable, quit the agent and `zw sync {name}`.", file=sys.stderr)
    if replace:
        zellij("close-tab-by-id", replace)
    if zellij("new-tab", "--layout-string", layout(name, path, agent)) is None:
        sys.exit("zellij couldn't open the tab.")


def view(zsession, name, path, replace, agent):
    """In Orca's terminal: tab NAME running AGENT with this terminal's Orca
    identity, then this terminal attached to the session. The view lands on
    a tab zellij picks, usually the new one: no zellij action steers one
    chosen client, so the person may switch it once."""
    identity = [f"{k}={os.environ[k]}" for k in IDENTITY if k in os.environ]
    if replace:
        zellij("close-tab-by-id", replace, name=zsession)
    if identity:
        agent = [sys.executable, os.path.realpath(__file__), "run", *identity, "--", *agent]
    if zellij("new-tab", "--layout-string", layout(name, path, agent), name=zsession) is None:
        sys.exit(f"zellij couldn't open tab {name} in session {zsession}: is a client attached?")
    os.execvp("zellij", ["zellij", "attach", zsession])


def run_with(args):
    """`zw run KEY=VALUE... -- COMMAND...`: COMMAND with those set (no `env`
    on Windows)."""
    split = args.index("--")
    os.environ.update(a.split("=", 1) for a in args[:split])
    os.execvp(args[split + 1], args[split + 1:])


def program(command):
    """The agent COMMAND runs, or "": the first word naming one (zellij gives
    the command as one string, and a value before it may hold spaces; the
    brief comes after it)."""
    names = [os.path.basename(w) for w in command.split()]
    return next((n for n in names if n in AGENTS), "")


def resumed(command, session=None):
    """The command resuming the agent a tab was started with COMMAND for:
    Claude's SESSION, else the latest in the worktree; Codex's latest there."""
    agent = program(command)
    if agent == "codex":
        return ["codex", *CODEX_FLAGS, "resume", "--last"]
    if agent != "claude":
        sys.exit(f"Not an agent zw knows how to resume: {command!r}")
    words = command.split()
    kept, rest = [], words[[os.path.basename(w) for w in words].index("claude") + 1:]
    while rest:
        if rest[0] == "--continue":  # an agent synced before
            rest = rest[1:]
        elif rest[0] == "--resume" and len(rest) >= 2:  # one resumed by hand
            rest = rest[2:]
        elif rest[0] in KEPT_FLAGS and len(rest) >= 2:
            kept, rest = kept + rest[:2], rest[2:]
        else:
            break
    return ["claude", *(["--resume", session] if session else ["--continue"]), *kept]


def sync(name):
    """An agent in tab NAME, quit by the person, resumed with Orca's view."""
    attached()
    tid = tab_id(name)
    if tid is None:
        sys.exit(f"No tab named {name}.")
    panes = [p for p in json.loads(zellij("list-panes", "--json", capture=True) or "[]")
             if p["tab_id"] == tid and not p["is_plugin"] and not p["is_floating"]]
    if len(panes) != 1:
        sys.exit(f"Tab {name} has {len(panes)} tiled panes; expected the agent's alone.")
    pane = panes[0]
    # zw's tabs run the agent as the pane's command; once it quits, the pane
    # holds or drops to a shell.
    started = pane.get("terminal_command") or ""
    if not started:
        sys.exit(f"Tab {name}'s agent was typed into a shell: resume it by hand.")
    if not pane["exited"] and program(pane.get("pane_command") or "") in AGENTS:
        sys.exit(f"Quit the agent in tab {name} first (Claude: /exit; Codex: /quit), then rerun.")
    if problem := orca_unreachable():
        sys.exit(f"Orca can't be reached: {problem}.")
    # zellij drops an exited pane's folder.
    path = pane.get("pane_cwd") or target(name)[0]
    old = next((w.split("=", 1)[1] for w in started.split() if w.startswith("ORCA_TAB_ID=")), None)
    # A pooled worktree holds earlier tasks' sessions, so not its latest:
    # the latest on the tab's branch, as `new -c` resumes.
    branch = git("branch", "--show-current", cwd=path) or target(name)[1]
    session = session_of(path, branch)
    if program(started) == "claude" and session is None:
        sys.exit(f"No Claude session on {branch} in {path}: resume it by hand.")
    open_views(name, path, resumed(started, session), replace=str(tid))
    if old:  # the old tab's view would fall to another tab
        close_views(lambda t: t.get("tabId") == old)


def close_views(which):
    """Close Orca's terminals WHICH picks from `orca terminal list`."""
    if orca_unreachable():
        return
    listed = subprocess.run([ORCA, "terminal", "list", "--json"], capture_output=True,
                            encoding="utf-8").stdout
    for terminal in json.loads(listed or "{}").get("result", {}).get("terminals", []):
        if which(terminal):
            subprocess.run([ORCA, "terminal", "close", "--terminal", terminal["handle"]],
                           capture_output=True)


def kdl(text):
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def layout(name, path, agent):
    """The agent full-size, a hidden floating shell (Alt+w). A layout-made
    tab gets no bars from the session's template, so it brings zellij's
    default ones."""
    args = f" {{ args {' '.join(kdl(a) for a in agent[1:])}; }}" if agent[1:] else ""
    return f"""layout {{
  tab name={kdl(name)} cwd={kdl(path)} hide_floating_panes=true {{
    pane size=1 borderless=true {{ plugin location="tab-bar"; }}
    pane command={kdl(agent[0])}{args}
    pane size=1 borderless=true {{ plugin location="status-bar"; }}
    floating_panes {{ pane; }}
  }}
}}"""


def ls():
    trees = worktrees()
    free = set(idle(trees, trees[0][0]))
    for path, branch in trees:
        if path in free:
            print(f"{'(idle)':<28} {'':>5} {'':<15} {path}")
            continue
        onto = base(branch, cwd=path)
        ahead = git("rev-list", "--count", f"{onto}..{branch}", cwd=path) if branch != onto else ""
        dirty = len(git("status", "--porcelain", cwd=path).splitlines())
        print(f"{branch:<28} {'+' + ahead if ahead and ahead != '0' else '':>5} "
              f"{f'{dirty} uncommitted' if dirty else '':<15} {path}")


def land(check):
    branch = git("branch", "--show-current")
    onto = branch and base(branch)
    if not branch or onto == branch:
        sys.exit("Run `zw land` from a worktree, on its branch.")
    holder = next((path for path, b in worktrees() if b == onto), None)
    if holder is None:
        sys.exit(f"{onto} isn't checked out in any worktree.")
    if git("status", "--porcelain"):
        sys.exit("Commit (or drop) this worktree's changes first.")
    print(f"Rebasing {branch} onto {onto}...", flush=True)
    if not run("git", "rebase", onto):
        sys.exit("The rebase stopped on a conflict: resolve it, `git rebase --continue`, land again.")
    if check and not run(*check):
        sys.exit(f"`{' '.join(check)}` failed after the rebase: fix it, commit, land again.")
    if not run("git", "merge", "--ff-only", branch, cwd=holder):
        sys.exit(f"Couldn't fast-forward {onto}: it moved (land again), or {holder} "
                 "has uncommitted changes in the same files.")
    print(f"Landed: {onto} is now at {branch} ({git('rev-parse', '--short', 'HEAD')}).")


def done(name, checked=False):
    main = worktrees()[0][0]
    path, branch = target(name)
    if os.path.isdir(path):
        onto = base(branch, cwd=main)
        if git("status", "--porcelain", cwd=path):
            sys.exit(f"{path} has uncommitted changes.")
        if not checked and git("rev-list", "--count", f"{onto}..{branch}", cwd=main) not in ("", "0"):
            sys.exit(f"{branch} has commits not in {onto}: land it first.")
    close_views(lambda t: os.path.realpath(t.get("worktreePath", "")) == os.path.realpath(path))
    if os.path.isdir(path):
        release(path, branch, main)
    tid = tab_id(name)
    if tid is not None:
        zellij("close-tab-by-id", str(tid))


def release(path, branch, main):
    """A landed task's worktree goes: a pooled one is detached for the next
    task, its build kept warm, unless the pool already has enough idle."""
    if pooled(path, main):
        if not run("git", "switch", "-q", "--detach", cwd=path):
            sys.exit(1)
        run("git", "branch", "-D", branch, cwd=main)
        free = idle(worktrees(), main)
        if len(free) > pool_size(main):
            # The stalest goes: its build is the furthest from what's next.
            stalest = min(free, key=lambda p: int(git("log", "-1", "--format=%ct", cwd=p) or 0))
            run("git", "worktree", "remove", "--force", stalest, cwd=main)
        return
    # Checked clean above; --force because git won't otherwise remove a worktree
    # with submodules.
    if not run("git", "worktree", "remove", "--force", path, cwd=main):
        sys.exit(1)
    run("git", "branch", "-D", branch, cwd=main)


def status(state):
    """Mark the tab holding this pane: `name ●` while the agent works."""
    pane = os.environ.get("ZELLIJ_PANE_ID")
    out = pane and zellij("list-panes", "--json", "--tab", capture=True)
    if not out:
        return
    tab = next((p["tab_id"] for p in json.loads(out)
                if not p["is_plugin"] and str(p["id"]) == pane), None)
    name = next((t["name"] for t in tabs() if t["tab_id"] == tab), None)
    if name is None:
        return
    base = MARK_RE.sub("", name)
    marked = f"{base} {MARKS[state]}" if MARKS[state] else base
    if marked != name:
        zellij("rename-tab-by-id", str(tab), marked)


def main():
    args = sys.argv[1:]
    command, rest = (args[0], args[1:]) if args else ("", [])
    if command == "new" and rest:
        new(rest[0], rest[1:])
    elif command == "add" and len(rest) == 1:
        add(rest[0])
    elif command == "path" and len(rest) == 1:
        print(target(rest[0])[0])
    elif command == "go" and len(rest) == 1:
        attached()
        go(rest[0]) or sys.exit(f"No tab named {rest[0]}.")
    elif command == "ls":
        ls()
    elif command == "land":
        land(rest)
    elif command == "done" and len(rest) == 1:
        done(rest[0])
    elif command == "done" and rest[1:] == ["--checked"]:
        done(rest[0], checked=True)
    elif command == "sync" and len(rest) == 1:
        sync(rest[0])
    elif command == "view" and "--" in rest and len(rest[:rest.index("--")]) in (3, 4):
        head, agent = rest[:rest.index("--")], rest[rest.index("--") + 1:]
        view(*head[:3], head[3] if len(head) == 4 else None, agent)
    elif command == "run" and "--" in rest:
        run_with(rest)
    elif command == "status" and rest and rest[0] in MARKS:
        status(rest[0])  # Codex's notify appends a JSON argument; it's ignored
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
