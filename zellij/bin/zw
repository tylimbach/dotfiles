#!/usr/bin/env python3
"""zw: one zellij tab per git worktree, each with its own agent.

Worktrees live next to the main checkout as ../<repo>-NAME on branch
agent/NAME, branched from the main checkout's current branch (the "active
branch"). Inside zellij, each gets a tab named NAME running the agent, with a
hidden floating shell in the worktree (Alt+w).

  zw new NAME [--codex] [ARGS...]  worktree + tab + agent (ARGS go to the agent);
                                   an existing NAME just gets its tab back
  zw add NAME                      worktree only
  zw go NAME                       focus NAME's tab
  zw ls                            worktrees: branch, commits ahead, uncommitted files
  zw land [CHECK...]               from a worktree: rebase onto the active branch,
                                   run CHECK (e.g. `just check`), fast-forward it
  zw done NAME                     once landed: close the tab, remove worktree and branch
  zw status working|input|done|clear
                                   agent hooks: mark this pane's tab name
"""
import json
import os
import re
import subprocess
import sys

MARKS = {"working": "●", "input": "?", "done": "✓", "clear": ""}
MARK_RE = re.compile(r" [●?✓]$")


def git(*args, cwd=None):
    out = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    return out.stdout.rstrip() if out.returncode == 0 else ""


def run(*args, cwd=None):
    return subprocess.run(list(args), cwd=cwd).returncode == 0


def live():
    """This shell's zellij session is running. A renamed session keeps its
    old name in ZELLIJ_SESSION_NAME, and actions sent there hang."""
    out = subprocess.run(["zellij", "list-sessions", "--no-formatting"],
                         capture_output=True, text=True).stdout
    alive = {line.split()[0] for line in out.splitlines() if line and "EXITED" not in line}
    return os.environ.get("ZELLIJ_SESSION_NAME") in alive


def zellij(*args, capture=False):
    """A zellij action in this session, or None outside a live one."""
    if "ZELLIJ" not in os.environ or not live():
        return None
    try:
        out = subprocess.run(["zellij", "action", *args], capture_output=True, text=True,
                             timeout=3, stdin=subprocess.DEVNULL)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None
    if out.returncode != 0:
        return None
    return out.stdout if capture else ""


def tabs():
    out = zellij("list-tabs", "--json", capture=True)
    return json.loads(out) if out else []


def tab_id(name):
    return next((t["tab_id"] for t in tabs() if MARK_RE.sub("", t["name"]) == name), None)


def go(name):
    tid = tab_id(name)
    return tid is not None and zellij("go-to-tab-by-id", str(tid)) is not None


def worktrees():
    """(path, branch) of every worktree, the main checkout first."""
    found, path = [], None
    for line in git("worktree", "list", "--porcelain").splitlines():
        if line.startswith("worktree "):
            path = line[len("worktree "):]
        elif line.startswith("branch ") and path:
            found.append((path, line[len("branch refs/heads/"):]))
        elif line == "detached" and path:
            found.append((path, "(detached)"))
    if not found:
        sys.exit("Not in a git repository.")
    return found


def target(name):
    main, _ = worktrees()[0]
    return os.path.join(os.path.dirname(main), f"{os.path.basename(main)}-{name}")


def add(name):
    main, active = worktrees()[0]
    path = target(name)
    if os.path.isdir(path):
        return path
    if not run("git", "worktree", "add", "-b", f"agent/{name}", path, active, cwd=main):
        sys.exit(1)
    print(f"agent/{name} from {active}, in {path}", flush=True)
    return path


def new(name, args):
    path = add(name)
    if "ZELLIJ" not in os.environ:
        sys.exit(f"Not in zellij: cd {path}")
    if go(name):
        return
    agent = ["codex", *[a for a in args if a != "--codex"]] if "--codex" in args else ["claude", *args]
    zellij("new-tab", "--layout-string", layout(name, path, agent))


def kdl(text):
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def layout(name, path, agent):
    """The agent full-size, a hidden floating shell (Alt+w). A layout-made
    tab gets no bar from the session's template, so it brings its own."""
    args = f" {{ args {' '.join(kdl(a) for a in agent[1:])}; }}" if agent[1:] else ""
    return f"""layout {{
  tab name={kdl(name)} cwd={kdl(path)} hide_floating_panes=true {{
    pane command={kdl(agent[0])}{args}
    pane size=1 borderless=true {{ plugin location="compact-bar"; }}
    floating_panes {{ pane; }}
  }}
}}"""


def ls():
    trees = worktrees()
    _, active = trees[0]
    for path, branch in trees:
        ahead = git("rev-list", "--count", f"{active}..{branch}", cwd=path) if branch != active else ""
        dirty = len(git("status", "--porcelain", cwd=path).splitlines())
        print(f"{branch:<28} {'+' + ahead if ahead and ahead != '0' else '':>5} "
              f"{f'{dirty} uncommitted' if dirty else '':<15} {path}")


def land(check):
    trees = worktrees()
    main, active = trees[0]
    here = git("rev-parse", "--show-toplevel")
    branch = git("branch", "--show-current")
    if os.path.realpath(here) == os.path.realpath(main) or not branch:
        sys.exit("Run `zw land` from a worktree, on its branch.")
    if git("status", "--porcelain"):
        sys.exit("Commit (or drop) this worktree's changes first.")
    print(f"Rebasing {branch} onto {active}...", flush=True)
    if not run("git", "rebase", active):
        sys.exit("The rebase stopped on a conflict: resolve it, `git rebase --continue`, land again.")
    if check and not run(*check):
        sys.exit(f"`{' '.join(check)}` failed after the rebase: fix it, commit, land again.")
    if not run("git", "merge", "--ff-only", branch, cwd=main):
        sys.exit(f"Couldn't fast-forward {active}: it moved (land again), or the main checkout "
                 "has uncommitted changes in the same files.")
    print(f"Landed: {active} is now at {branch} ({git('rev-parse', '--short', 'HEAD')}).")


def done(name):
    main, active = worktrees()[0]
    path, branch = target(name), f"agent/{name}"
    if os.path.isdir(path):
        if git("status", "--porcelain", cwd=path):
            sys.exit(f"{path} has uncommitted changes.")
        if git("rev-list", "--count", f"{active}..{branch}", cwd=main) not in ("", "0"):
            sys.exit(f"{branch} has commits not in {active}: land it first.")
        if not run("git", "worktree", "remove", path, cwd=main):
            sys.exit(1)
        run("git", "branch", "-d", branch, cwd=main)
    tid = tab_id(name)
    if tid is not None:
        zellij("close-tab-by-id", str(tid))


def status(state):
    """Mark the tab holding this pane: `name ●` while the agent works."""
    pane = os.environ.get("ZELLIJ_PANE_ID")
    out = pane and zellij("list-panes", "--json", "--tab", capture=True)
    if not out:
        return
    tab = next((p["tab_id"] for p in json.loads(out)
                if not p["is_plugin"] and str(p["id"]) == pane), None)
    name = next((t["name"] for t in tabs() if t["tab_id"] == tab), None)
    if name is None:
        return
    base = MARK_RE.sub("", name)
    marked = f"{base} {MARKS[state]}" if MARKS[state] else base
    if marked != name:
        zellij("rename-tab-by-id", str(tab), marked)


def main():
    args = sys.argv[1:]
    command, rest = (args[0], args[1:]) if args else ("", [])
    if command == "new" and rest:
        new(rest[0], rest[1:])
    elif command == "add" and len(rest) == 1:
        add(rest[0])
    elif command == "go" and len(rest) == 1:
        go(rest[0]) or sys.exit(f"No tab named {rest[0]}.")
    elif command == "ls":
        ls()
    elif command == "land":
        land(rest)
    elif command == "done" and len(rest) == 1:
        done(rest[0])
    elif command == "status" and rest and rest[0] in MARKS:
        status(rest[0])  # Codex's notify appends a JSON argument; it's ignored
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
