[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[delta "gruvbox-dark"]
	dark = true
	syntax-theme = gruvbox-dark
[delta "gruvbox-light"]
	light = true
	syntax-theme = gruvbox-light
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
	colorMovedWS = allow-indentation-change
