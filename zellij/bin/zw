#!/usr/bin/env python3
"""zw: one git worktree per task, each with its own agent.

Worktrees live next to the main checkout as ../<repo>-NAME on branch
agent/NAME, branched from the checkout zw runs in, which becomes the branch's
upstream (its "base"), so a story's worktree can branch its own tasks.

A repo can keep a pool instead (`git config zw.pool N`): worktrees at
../<repo>-pool-K, reused, so a task starts from the last one's build.
`add` switches an idle one (detached, clean) to agent/NAME, else makes
another; `done` detaches it and deletes the branch, keeping its files,
and removes it only past N idle. A pooled worktree holds many tasks'
agent sessions, so resuming takes the latest one on agent/NAME.

Each agent runs on one host, the repo's (`git config zw.host`):
- orca: a terminal in Orca (onorca.dev), started as Orca starts agents,
  with its default arguments (Settings → Agents), so Orca and its phone
  app see the agent's status and questions;
- zellij (the default): a tab named NAME running the agent, with a hidden
  floating shell in the worktree (Alt+w), marked by the agent's hooks.
`move` quits each idle agent and resumes its conversation on the other
host. One conversation never runs in two processes: each would keep its
own history. Claude sessions are named NAME on either host (`--name`,
`/rename`), the address other sessions message them by.

  zw new NAME [--codex] [--model M] [--effort E] [-c] [ARGS...] [BRIEF]
                                   worktree + agent on the repo's host (-c resumes
                                   NAME's conversation); a running NAME gets focus
  zw add NAME                      worktree only
  zw path NAME                     NAME's worktree directory
  zw go NAME                       focus NAME's agent
  zw ls                            worktrees: branch, commits ahead, uncommitted files
  zw land [CHECK...]               from a worktree: rebase onto its base,
                                   run CHECK (e.g. `just check`), fast-forward it
  zw done NAME [--checked]         once landed: close the agent, remove worktree and branch
                                   (--checked: the caller checked it landed, e.g. by patch)
  zw resume NAME                   NAME's agent, quit or its tab closed: resumed on the host
  zw move orca|zellij [NAME...]    the repo's host becomes HOST, and every agent (or NAME's)
                                   that is idle moves there; busy ones are listed
  zw msg NAME TEXT                 TEXT and Enter into NAME's agent, on either host
  zw status working|input|done|clear
                                   agent hooks: mark this pane's zellij tab name

Orca starts agents with --model, --effort and the brief only; zellij passes
other ARGS to the agent, and a move drops them. Setup: orca/README.md.
"""
import collections
import glob
import itertools
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time

MARKS = {"working": "●", "input": "?", "done": "✓", "clear": ""}
MARK_RE = re.compile(r" [●?✓]$")
# On Linux `orca` is usually the GNOME screen reader; Orca's CLI is `orca-ide`.
# Its install path too: a zellij pane keeps its server's PATH, maybe from before
# Orca put its CLI there.
ORCA = (shutil.which("orca-ide" if sys.platform == "linux" else "orca")
        or (os.path.join(os.environ.get("LOCALAPPDATA", ""), "Programs", "orca", "resources",
                         "bin", "orca.exe") if os.name == "nt"
            else "/Applications/Orca.app/Contents/Resources/bin/orca"))
NO_ORCA = "Orca isn't installed"
# Orca's settings, which hold its agents' default arguments: Electron's
# per-user data folder (the Windows and Linux ones untested).
ORCA_SETTINGS = [os.path.join(os.path.expanduser(folder), "orca", "profiles", "local-default",
                              "orca-data.json") for folder in (
    "~/Library/Application Support", os.environ.get("APPDATA", "~/AppData/Roaming"),
    os.environ.get("XDG_CONFIG_HOME", "~/.config"))]
HOSTS = ("orca", "zellij")
AGENTS = ("claude", "codex")
QUIT = {"claude": "/exit", "codex": "/quit"}
# Agent states in which an agent waits on no one: quitting it loses no turn
# and leaves no question unanswered.
RESTING = ("done", "idle")
# States in which typing reaches the agent's input. In any other (waiting on
# a question, or not yet heard from) its screen may hold a question or a
# menu, Codex's update offer or a trust prompt, where text and Enter pick
# an answer.
TYPABLE = (*RESTING, "working")
# Codex otherwise hands turns to a shared background server, which runs the
# hooks in its own environment, so a zellij tab gets no marks. Orca's
# terminals isolate Codex themselves.
CODEX_FLAGS = ("--no-daemon",)
# Codex's first prompt after a resume.
MOVED = ("(zw: this conversation was resumed in {}. Nothing else changed: carry on, "
         "or if you were waiting for someone, keep waiting.)")
# What a resumed agent keeps of how it was started.
SPEC = ("agent", "model", "effort")

# An agent running now: its host, which agent, Orca's state or zellij's
# mark, Orca's terminal handle or zellij's pane id, and its tab (Orca's id,
# which outlives the handle: Orca issues a new one once its window adopts a
# terminal it started unseen; zellij's record).
Running = collections.namedtuple("Running", "host agent state ref tab")


def git(*args, cwd=None):
    out = subprocess.run(["git", *args], cwd=cwd, capture_output=True, encoding="utf-8")
    return out.stdout.rstrip() if out.returncode == 0 else ""


def run(*args, cwd=None):
    return subprocess.run(list(args), cwd=cwd).returncode == 0


def sessions():
    """Every running zellij session, zw's first."""
    try:
        out = subprocess.run(["zellij", "list-sessions", "--no-formatting"],
                             capture_output=True, encoding="utf-8").stdout
    except FileNotFoundError:
        return []
    alive = [line.split()[0] for line in out.splitlines() if line and "EXITED" not in line]
    own = session()
    return sorted(alive, key=lambda name: name != own)


def session():
    """The zellij session zw drives, or None: this pane's, else the one named
    for the repo's main checkout, so zw works from outside zellij too (an Orca
    terminal). A renamed session keeps its old name in ZELLIJ_SESSION_NAME,
    and actions sent there hang."""
    try:
        out = subprocess.run(["zellij", "list-sessions", "--no-formatting"],
                             capture_output=True, encoding="utf-8").stdout
    except FileNotFoundError:
        return None
    alive = {line.split()[0] for line in out.splitlines() if line and "EXITED" not in line}
    if os.environ.get("ZELLIJ_SESSION_NAME") in alive:
        return os.environ["ZELLIJ_SESSION_NAME"]
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    repo = os.path.basename(os.path.dirname(common)) if common else None
    return repo if repo in alive else None


def zellij(*args, capture=False, name=None):
    """A zellij action in session NAME (by default zw's), or None without one."""
    name = name or session()
    if name is None:
        return None
    try:
        out = subprocess.run(["zellij", "--session", name, "action", *args], capture_output=True,
                             encoding="utf-8", timeout=3, stdin=subprocess.DEVNULL)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None
    if out.returncode != 0:
        return None
    return out.stdout if capture else ""


def orca(*args, failing=None):
    """An Orca CLI command's result, or None if it failed; given FAILING,
    a failure exits, saying FAILING and Orca's reason."""
    try:
        out = subprocess.run([ORCA, *args, "--json"], capture_output=True, encoding="utf-8")
        reply = json.loads(out.stdout)
    except (OSError, ValueError):
        reply = {}
    if reply.get("ok"):
        return reply.get("result")
    if failing:
        sys.exit(f"{failing}: {(reply.get('error') or {}).get('message') or 'no reply'}")
    return None


def orca_unreachable():
    """Why Orca can't be reached, or None when it can. A running Orca can
    look absent: a sandboxed shell can't open its socket, and the PATH link
    its settings install can be one the user can't resolve."""
    if not os.path.exists(ORCA):
        return NO_ORCA
    reply = subprocess.run([ORCA, "status", "--json"], capture_output=True, encoding="utf-8")
    try:
        if json.loads(reply.stdout)["result"]["runtime"]["reachable"]:
            return None
    except (ValueError, KeyError, TypeError):
        pass
    said = (reply.stdout + reply.stderr).strip().splitlines()
    return f"`orca status` says {said[-1]!r}" if said else "`orca status` said nothing"


def reachable(path=None):
    """Exit unless Orca can be reached and, given PATH, knows that worktree
    (it finds a new one by watching git, so after a moment)."""
    if problem := orca_unreachable():
        sys.exit(f"Orca can't be reached: {problem}.")
    for _ in range(20 if path else 0):
        if orca("worktree", "show", "--worktree", f"path:{path}") is not None:
            return
        time.sleep(0.5)
    if path:
        sys.exit(f"Orca doesn't list {path}: is the repo a project there, external worktrees shown?")


def attached():
    """Exit unless zw has a zellij session to drive."""
    if session() is None:
        sys.exit(f"No zellij session: this pane's ({os.environ.get('ZELLIJ_SESSION_NAME')!r}) "
                 "isn't running (renamed since it opened?), and none is named for the repo.")


def tabs(name=None):
    out = zellij("list-tabs", "--json", capture=True, name=name)
    return json.loads(out) if out else []


def tab_of(name):
    """Zellij's tab NAME, or None."""
    return next((t for t in tabs() if MARK_RE.sub("", t["name"]) == name), None)


def worktrees():
    """(path, branch) of every worktree, the main checkout first."""
    found, path = [], None
    for line in git("worktree", "list", "--porcelain").splitlines():
        if line.startswith("worktree "):
            path = line[len("worktree "):]
        elif line.startswith("branch ") and path:
            found.append((path, line[len("branch refs/heads/"):]))
        elif line == "detached" and path:
            found.append((path, "(detached)"))
    if not found:
        sys.exit("Not in a git repository.")
    return found


def target(name):
    """NAME's worktree and branch: an existing one, zw's (agent/NAME) or
    Claude Code's (worktree-NAME, under .claude/worktrees), else where zw
    makes it."""
    trees = worktrees()
    main = trees[0][0]
    folder = f"{os.path.basename(main)}-{name}"
    for path, branch in trees[1:]:
        if (name == branch or os.path.basename(path) in (name, folder)
                or branch in (f"agent/{name}", f"worktree-{name}")):
            return path, branch
    return os.path.join(os.path.dirname(main), folder), f"agent/{name}"


def tasks():
    """Every task's name, from its worktree's branch."""
    return [re.sub(r"^(agent/|worktree-)", "", branch) for _, branch in worktrees()[1:]
            if branch != "(detached)"]


def base(branch, cwd=None):
    """The local branch BRANCH lands into: its upstream, else the main
    checkout's branch (worktrees made before zw recorded one)."""
    ref = git("for-each-ref", "--format=%(upstream)", f"refs/heads/{branch}", cwd=cwd)
    return ref[len("refs/heads/"):] if ref.startswith("refs/heads/") else worktrees()[0][1]


def pool_size(main):
    """How many idle worktrees the repo keeps (`git config zw.pool N`); 0 by
    default: a worktree per task, removed when done."""
    value = git("config", "--get", "zw.pool", cwd=main)
    return int(value) if value.isdigit() else 0


def pooled(path, main):
    return re.fullmatch(re.escape(os.path.basename(main)) + r"-pool-\d+",
                        os.path.basename(path)) is not None


def idle(trees, main):
    """Pooled worktrees no task holds: detached and clean."""
    return [path for path, branch in trees[1:] if pooled(path, main)
            and branch == "(detached)" and not git("status", "--porcelain", cwd=path)]


def add(name):
    trees = worktrees()
    main = trees[0][0]
    path, branch = target(name)
    if os.path.isdir(path):
        return path
    here = git("branch", "--show-current") or trees[0][1]
    free = idle(trees, main) if pool_size(main) else []
    if free:
        path = free[0]
        if not run("git", "switch", "-q", "-c", branch, here, cwd=path):
            sys.exit(1)
    else:
        if pool_size(main):
            taken = {os.path.basename(p) for p, _ in trees}
            slot = next(f"{os.path.basename(main)}-pool-{k}" for k in itertools.count(1)
                        if f"{os.path.basename(main)}-pool-{k}" not in taken)
            path = os.path.join(os.path.dirname(main), slot)
        if not run("git", "worktree", "add", "-b", branch, path, here, cwd=main):
            sys.exit(1)
    git("branch", f"--set-upstream-to={here}", branch, cwd=main)
    print(f"{branch} from {here}, in {path}", flush=True)
    return path


def host():
    """Where the repo's agents start: `git config zw.host`, zellij by default."""
    value = git("config", "--get", "zw.host")
    return value if value in HOSTS else "zellij"


def session_of(path, branch):
    """The latest Claude Code session in PATH on BRANCH, or None: its
    transcripts sit in a folder named for the directory, and each message
    records the branch it ran on."""
    folder = os.path.join(os.path.expanduser("~/.claude/projects"),
                          re.sub(r"[^A-Za-z0-9-]", "-", path))
    for transcript in sorted(glob.glob(os.path.join(folder, "*.jsonl")),
                             key=os.path.getmtime, reverse=True):
        with open(transcript, encoding="utf-8", errors="replace") as f:
            if any(f'"gitBranch":"{branch}"' in line.replace(" ", "") for line in f):
                return os.path.basename(transcript)[:-len(".jsonl")]
    return None


def codex_session_of(path, branch):
    """The latest Codex session started in PATH on BRANCH, or None: each
    transcript's first line records its folder and branch. (`codex resume
    --last` can pick another worktree's.)"""
    home = os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")
    transcripts = glob.glob(os.path.join(home, "sessions", "*", "*", "*", "rollout-*.jsonl"))
    for transcript in sorted(transcripts, key=os.path.getmtime, reverse=True)[:500]:
        try:
            with open(transcript, encoding="utf-8") as f:
                meta = json.loads(f.readline()).get("payload", {})
        except (OSError, ValueError):
            continue
        if (os.path.realpath(meta.get("cwd") or "/") == path
                and (meta.get("git") or {}).get("branch") == branch):
            return meta.get("id")
    return None


def program(command):
    """The agent COMMAND runs, or "": the first word naming one (zellij gives
    the command as one string; the brief comes after it)."""
    words = [os.path.basename(w) for w in command.split()]
    return next((w for w in words if w in AGENTS), "")


def record(name, spec):
    git("config", "--remove-section", f"zw.{name}")
    for key in SPEC:
        if spec.get(key):
            git("config", f"zw.{name}.{key}", spec[key])


def recorded(name, started=""):
    """How NAME's agent was started (SPEC), as `new` recorded it, else read
    from the command a zellij tab STARTED it with (an agent from before zw
    recorded it)."""
    spec = {key: git("config", "--get", f"zw.{name}.{key}") for key in SPEC}
    if not spec["agent"]:
        words = started.split()
        spec["agent"] = program(started) or "claude"
        for flag, key in (("--model", "model"), ("-m", "model"), ("--effort", "effort")):
            if flag in words[:-1]:
                spec[key] = words[words.index(flag) + 1]
        record(name, spec)
    return spec


def flags(spec):
    model, effort = spec.get("model"), spec.get("effort")
    if spec["agent"] == "codex":
        return [*(["-m", model] if model else []),
                *(["-c", f"model_reasoning_effort={effort}"] if effort else [])]
    return [*(["--model", model] if model else []), *(["--effort", effort] if effort else [])]


def orca_defaults(agent):
    """How Orca starts AGENT: its command and default arguments (Settings →
    Agents), so an agent resumed there runs as one Orca started."""
    for path in ORCA_SETTINGS:
        try:
            with open(path, encoding="utf-8") as f:
                settings = json.load(f)["settings"]
        except (OSError, ValueError, KeyError):
            continue
        command = (settings.get("agentCmdOverrides") or {}).get(agent) or agent
        arguments = (settings.get("agentDefaultArgs") or {}).get(agent) or ""
        return shlex.split(command), shlex.split(arguments)
    print(f"Couldn't read Orca's settings: {agent} starts without Orca's default arguments.",
          file=sys.stderr)
    return [agent], []


def resuming(name, on, spec, path):
    """The command resuming NAME's conversation on host ON: the agent's
    latest session in the worktree on its branch (a pooled worktree holds
    earlier tasks')."""
    agent = spec["agent"]
    if on == "orca":
        command, arguments = orca_defaults(agent)
    else:
        command, arguments = [agent], list(CODEX_FLAGS) if agent == "codex" else []
    branch = git("branch", "--show-current", cwd=path) or target(name)[1]
    found = (codex_session_of if agent == "codex" else session_of)(os.path.realpath(path), branch)
    if found is None:
        sys.exit(f"No {agent} session on {branch} in {path}: resume it by hand.")
    if agent == "codex":
        # A first turn: Codex's hooks report only once one runs, and until
        # then nothing can tell its input from a menu on its screen.
        return [*command, *arguments, *flags(spec), "resume", found, MOVED.format(on)]
    return [*command, *arguments, "--name", name, *flags(spec), "--resume", found]


def pane_of(name):
    """Zellij tab NAME and its agent's pane, running or not, or None."""
    tab = tab_of(name)
    if tab is None:
        return None
    panes = [p for p in json.loads(zellij("list-panes", "--json", capture=True) or "[]")
             if p["tab_id"] == tab["tab_id"] and not p["is_plugin"] and not p["is_floating"]]
    return (tab, panes[0]) if len(panes) == 1 else None


def where(name):
    """NAME's agent, running now, or None. First an agent pane working in
    NAME's worktree in any zellij session, whatever its tab is called;
    else an agent Orca lists there. Zellij comes first because each agent
    zw started there before Orca hosted agents reports to Orca from an Orca
    terminal viewing its tab (Orca files it under whichever view is in the
    worktree), and typing into a view types into whichever tab it shows."""
    path = os.path.realpath(target(name)[0])
    for zsession in sessions():
        for pane in json.loads(zellij("list-panes", "--json", capture=True, name=zsession) or "[]"):
            agent = program(pane.get("pane_command") or "")
            if (agent and not pane["is_plugin"] and not pane["is_floating"] and not pane["exited"]
                    and os.path.realpath(pane.get("pane_cwd") or "/") == path):
                tab = next((t for t in tabs(zsession) if t["tab_id"] == pane["tab_id"]),
                           {"name": "", "tab_id": pane["tab_id"]})
                mark = tab["name"][-1] if MARK_RE.search(tab["name"]) else ""
                state = {"●": "working", "?": "waiting", "✓": "done"}.get(mark)
                if state != "waiting" and agent == "claude":
                    state = claude_state(path) or state
                return Running("zellij", agent, state or "unknown", f"terminal_{pane['id']}",
                               {**tab, "session": zsession,
                                "started": pane.get("terminal_command") or ""})
    if orca_unreachable():
        return None
    for tree in (orca("worktree", "ps") or {}).get("worktrees", []):
        if os.path.realpath(tree["path"]) != path:
            continue
        agents = [a for a in tree.get("agents", [])
                  if not a.get("parentPaneKey") and a.get("agentType") in AGENTS]
        # `terminal list` names a terminal the window hasn't shown yet (a new
        # worktree's) by its pty; `show` gives its tab.
        terminals = orca("terminal", "list", "--worktree", f"path:{path}")
        unheard = None
        for listed in (terminals or {}).get("terminals", []):
            terminal = (orca("terminal", "show", "--terminal", listed["handle"]) or {}).get("terminal", {})
            for agent in agents:
                if agent["paneKey"].split(":")[0] == terminal.get("tabId"):
                    return Running("orca", agent["agentType"], agent.get("state", ""),
                                   listed["handle"], terminal["tabId"])
            # Orca sees the process before the agent's hooks report (Codex's
            # wait for its first turn): running, its state unknown.
            if terminal.get("agentIdentity") in AGENTS:
                unheard = unheard or Running("orca", terminal["agentIdentity"], "unknown",
                                             listed["handle"], terminal["tabId"])
        if unheard:
            return unheard
    return None


def claude_state(path):
    """The state of the interactive Claude session working in PATH, as
    Claude reports it (it lists a session once it has started), or None."""
    try:
        out = subprocess.run(["claude", "agents", "--json"], capture_output=True, encoding="utf-8")
        listed = json.loads(out.stdout)
    except (OSError, ValueError):
        return None
    status = next((s.get("status") for s in listed if s.get("kind") == "interactive"
                   and os.path.realpath(s.get("cwd") or "/") == path), None)
    return {"idle": "done", "busy": "working"}.get(status, status)


def type_into(running, text):
    """TEXT and Enter into a running agent's input."""
    if running.host == "orca":
        return orca("terminal", "send", "--terminal", running.ref, "--text", text,
                    "--enter") is not None
    zsession = running.tab["session"]
    if zellij("write-chars", "--pane-id", running.ref, text, name=zsession) is None:
        return False
    time.sleep(0.5)  # an Enter right behind the text reads as part of a paste
    return zellij("write", "--pane-id", running.ref, "13", name=zsession) is not None


def focus(running):
    if running.host == "orca":
        return orca("terminal", "switch", "--terminal", running.ref) is not None
    return zellij("go-to-tab-by-id", str(running.tab["tab_id"]), name=running.tab["session"]) is not None


def new(name, args):
    path = add(name)
    if running := where(name):
        focus(running)
        return
    spec = {"agent": "codex" if "--codex" in args else "claude"}
    rest, extra, resume_ = [a for a in args if a != "--codex"], [], False
    while rest:
        if rest[0] in ("--model", "--effort") and len(rest) >= 2:
            spec[rest[0][2:]], rest = rest[1], rest[2:]
            continue
        if rest[0] in ("-c", "--continue"):
            resume_ = True
        else:
            extra.append(rest[0])
        rest = rest[1:]
    brief = extra.pop() if extra and not extra[-1].startswith("-") else None
    if host() == "orca" and not resume_:
        if extra:
            sys.exit(f"Orca starts agents with --model, --effort and a brief only, "
                     f"not {shlex.join(extra)}: `git config zw.host zellij` for those.")
        launch(name, path, spec, brief)
        return
    record(name, spec)
    if resume_:
        start(name, host(), path)
    else:
        own = list(CODEX_FLAGS) if spec["agent"] == "codex" else ["--name", name]
        open_tab(name, path, [spec["agent"], *own, *flags(spec), *extra, *([brief] if brief else [])])


def launch(name, path, spec, brief):
    """A new agent in Orca, started as Orca starts one."""
    reachable(path)
    if spec.get("effort") and not spec.get("model"):
        sys.exit("Orca takes --effort only with --model.")
    reply = orca("agent", "launch", "--agent", spec["agent"], "--worktree", f"path:{path}",
                 *(["--model", spec["model"]] if spec.get("model") else []),
                 *(["--effort", spec["effort"]] if spec.get("effort") else []),
                 *(["--prompt", brief] if brief else []),
                 failing=f"`orca agent launch` failed for {name}")
    handle = (reply.get("outcome") or {}).get("handle")
    if handle is None:
        sys.exit(f"`orca agent launch` gave {name} no terminal: {reply}")
    record(name, spec)
    orca("terminal", "rename", "--terminal", handle, "--title", name)
    print(f"{name}: {spec['agent']} in Orca ({handle})")
    if spec["agent"] != "claude":
        return
    # Orca's launch takes no --name. Typed once the agent has started (Orca
    # hears of it), so the shell doesn't read it; it applies when the
    # brief's first turn ends.
    for _ in range(60):
        if where(name):
            orca("terminal", "send", "--terminal", handle, "--text", f"/rename {name}", "--enter")
            return
        time.sleep(0.5)
    print(f"{name} hasn't reported to Orca: name it with `/rename {name}`.", file=sys.stderr)


def clients(zsession=None):
    out = zellij("list-clients", capture=True, name=zsession)
    return len([line for line in (out or "").splitlines()[1:] if line.strip()])


def retire(tab, zsession=None):
    """Tab id TAB goes: closed, or renamed NAME-old while a client views it
    (zellij 0.45 panics on a tab closed under a client's view)."""
    old = next((t for t in tabs(zsession) if t["tab_id"] == tab), None)
    if old and (old["active"] or old["other_focused_clients"]):
        zellij("rename-tab-by-id", str(tab), f"{MARK_RE.sub('', old['name'])}-old", name=zsession)
    elif old:
        zellij("close-tab-by-id", str(tab), name=zsession)


def open_tab(name, path, command, replace=None):
    """Zellij tab NAME running COMMAND in PATH, then tab id REPLACE retired.
    Only with a client attached: zellij 0.45 crashes on a tab made with
    none (it has no size to lay out in)."""
    attached()
    if not clients():
        sys.exit(f"No client is attached to zellij session {session()!r}: attach one, then retry.")
    if zellij("new-tab", "--layout-string", layout(name, path, command)) is None:
        sys.exit("zellij couldn't open the tab.")
    if replace is not None:
        retire(replace)


def start(name, on, path, left=None):
    """NAME's conversation, resumed on host ON. The zellij tab a quit agent
    LEFT (a tab record, by default zw's tab NAME) goes if it is zw's, with
    its Orca view from zw before Orca hosted agents."""
    if left is None:
        found = pane_of(name)
        left = found and {**found[0], "session": session(),
                          "started": found[1].get("terminal_command") or ""}
    started = left["started"] if left else ""
    command = resuming(name, on, recorded(name, started), path)
    # Only a tab zw made for NAME holds nothing else of the person's.
    replace = left["tab_id"] if left and MARK_RE.sub("", left["name"]) == name else None
    if on == "orca":
        reachable(path)
        shell = ["--shell", "git-bash"] if os.name == "nt" else []  # the command is POSIX-quoted
        orca("terminal", "create", "--worktree", f"path:{path}", "--title", name, *shell,
             "--command", shlex.join(command), failing=f"`orca terminal create` failed for {name}")
        if replace is not None:
            retire(replace, left["session"])
    elif left and left["session"] != session():
        open_tab(name, path, command)
        if replace is not None:
            retire(replace, left["session"])
    else:
        open_tab(name, path, command, replace=replace)
    view = next((w.split("=", 1)[1] for w in started.split() if w.startswith("ORCA_TAB_ID=")), None)
    if view:
        close_views(lambda t: t.get("tabId") == view)
    print(f"{name}: resumed in {on}")


def resume(name):
    if running := where(name):
        sys.exit(f"{name} is running in {running.host}: quit it first, or `zw move`.")
    start(name, host(), target(name)[0])


def move(to, names):
    if to == "orca":
        reachable()
    else:
        attached()
    git("config", "zw.host", to)
    busy = []
    for name in names or tasks():
        running = where(name)
        if running is None or running.host == to:
            if names:
                print(f"{name}: {'already in ' + to if running else 'no agent running'}")
            continue
        if running.state not in RESTING:
            busy.append(f"{name} ({running.state})")
            continue
        if not stop(name, running):
            print(f"{name}: still running in {running.host} after {QUIT[running.agent]}",
                  file=sys.stderr)
            continue
        if running.host == "orca":
            path = target(name)[0]
            close_views(lambda t: os.path.realpath(t.get("worktreePath", "")) == os.path.realpath(path)
                        and tab_of_terminal(t["handle"]) == running.tab)
        start(name, to, target(name)[0], left=running.tab if running.host == "zellij" else None)
    print(f"New agents start in {to}.")
    if busy:
        print(f"Left where they are, not idle: {', '.join(busy)}. "
              f"Rerun `zw move {to}` once they are.")


def stop(name, running):
    """Quit NAME's RUNNING agent: True once it has gone. Typed twice at most:
    once in testing, Orca accepted the first and it never arrived."""
    for _ in range(2):
        type_into(running, QUIT[running.agent])
        for _ in range(30):
            if where(name) is None:
                return True
            time.sleep(0.5)
    return False


def msg(name, text):
    running = where(name)
    if running is None:
        sys.exit(f"No agent named {name} is running.")
    if running.state not in TYPABLE:
        sys.exit(f"{name} is {running.state}: its screen may hold a question or a menu, which "
                 f"typing would answer. Look at it in {running.host} first.")
    if not type_into(running, text):
        sys.exit(f"Couldn't type into {name} in {running.host}.")


def go(name):
    running = where(name)
    if running is None:
        sys.exit(f"No agent named {name} is running.")
    if not focus(running):
        sys.exit(f"Couldn't focus {name} in {running.host}.")


def tab_of_terminal(handle):
    """An Orca terminal's tab (`terminal list` gives an unseen one's pty)."""
    return ((orca("terminal", "show", "--terminal", handle) or {}).get("terminal") or {}).get("tabId")


def close_views(which):
    """Close Orca's terminals WHICH picks from `orca terminal list`."""
    if orca_unreachable():
        return
    for terminal in (orca("terminal", "list") or {}).get("terminals", []):
        if which(terminal):
            orca("terminal", "close", "--terminal", terminal["handle"])


def kdl(text):
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def layout(name, path, agent):
    """The agent full-size, a hidden floating shell (Alt+w). A layout-made
    tab gets no bars from the session's template, so it brings zellij's
    default ones."""
    args = f" {{ args {' '.join(kdl(a) for a in agent[1:])}; }}" if agent[1:] else ""
    return f"""layout {{
  tab name={kdl(name)} cwd={kdl(path)} hide_floating_panes=true {{
    pane size=1 borderless=true {{ plugin location="tab-bar"; }}
    pane command={kdl(agent[0])}{args}
    pane size=1 borderless=true {{ plugin location="status-bar"; }}
    floating_panes {{ pane; }}
  }}
}}"""


def ls():
    trees = worktrees()
    free = set(idle(trees, trees[0][0]))
    for path, branch in trees:
        if path in free:
            print(f"{'(idle)':<28} {'':>5} {'':<15} {path}")
            continue
        onto = base(branch, cwd=path)
        ahead = git("rev-list", "--count", f"{onto}..{branch}", cwd=path) if branch != onto else ""
        dirty = len(git("status", "--porcelain", cwd=path).splitlines())
        print(f"{branch:<28} {'+' + ahead if ahead and ahead != '0' else '':>5} "
              f"{f'{dirty} uncommitted' if dirty else '':<15} {path}")


def land(check):
    branch = git("branch", "--show-current")
    onto = branch and base(branch)
    if not branch or onto == branch:
        sys.exit("Run `zw land` from a worktree, on its branch.")
    holder = next((path for path, b in worktrees() if b == onto), None)
    if holder is None:
        sys.exit(f"{onto} isn't checked out in any worktree.")
    if git("status", "--porcelain"):
        sys.exit("Commit (or drop) this worktree's changes first.")
    print(f"Rebasing {branch} onto {onto}...", flush=True)
    if not run("git", "rebase", onto):
        sys.exit("The rebase stopped on a conflict: resolve it, `git rebase --continue`, land again.")
    if check and not run(*check):
        sys.exit(f"`{' '.join(check)}` failed after the rebase: fix it, commit, land again.")
    if not run("git", "merge", "--ff-only", branch, cwd=holder):
        sys.exit(f"Couldn't fast-forward {onto}: it moved (land again), or {holder} "
                 "has uncommitted changes in the same files.")
    print(f"Landed: {onto} is now at {branch} ({git('rev-parse', '--short', 'HEAD')}).")


def done(name, checked=False):
    main = worktrees()[0][0]
    path, branch = target(name)
    if os.path.isdir(path):
        onto = base(branch, cwd=main)
        if git("status", "--porcelain", cwd=path):
            sys.exit(f"{path} has uncommitted changes.")
        if not checked and git("rev-list", "--count", f"{onto}..{branch}", cwd=main) not in ("", "0"):
            sys.exit(f"{branch} has commits not in {onto}: land it first.")
    close_views(lambda t: os.path.realpath(t.get("worktreePath", "")) == os.path.realpath(path))
    if os.path.isdir(path):
        release(path, branch, main)
    tab = tab_of(name)
    if tab is not None:
        retire(tab["tab_id"])
    git("config", "--remove-section", f"zw.{name}", cwd=main)


def release(path, branch, main):
    """A landed task's worktree goes: a pooled one is detached for the next
    task, its build kept warm, unless the pool already has enough idle."""
    if pooled(path, main):
        if not run("git", "switch", "-q", "--detach", cwd=path):
            sys.exit(1)
        run("git", "branch", "-D", branch, cwd=main)
        free = idle(worktrees(), main)
        if len(free) > pool_size(main):
            # The stalest goes: its build is the furthest from what's next.
            stalest = min(free, key=lambda p: int(git("log", "-1", "--format=%ct", cwd=p) or 0))
            run("git", "worktree", "remove", "--force", stalest, cwd=main)
        return
    # Checked clean above; --force because git won't otherwise remove a worktree
    # with submodules.
    if not run("git", "worktree", "remove", "--force", path, cwd=main):
        sys.exit(1)
    run("git", "branch", "-D", branch, cwd=main)


def status(state):
    """Mark the zellij tab holding this pane: `name ●` while the agent works."""
    pane = os.environ.get("ZELLIJ_PANE_ID")
    out = pane and zellij("list-panes", "--json", "--tab", capture=True)
    if not out:
        return
    tab = next((p["tab_id"] for p in json.loads(out)
                if not p["is_plugin"] and str(p["id"]) == pane), None)
    name = next((t["name"] for t in tabs() if t["tab_id"] == tab), None)
    if name is None:
        return
    unmarked = MARK_RE.sub("", name)
    marked = f"{unmarked} {MARKS[state]}" if MARKS[state] else unmarked
    if marked != name:
        zellij("rename-tab-by-id", str(tab), marked)


def main():
    args = sys.argv[1:]
    command, rest = (args[0], args[1:]) if args else ("", [])
    if command == "new" and rest:
        new(rest[0], rest[1:])
    elif command == "add" and len(rest) == 1:
        add(rest[0])
    elif command == "path" and len(rest) == 1:
        print(target(rest[0])[0])
    elif command == "go" and len(rest) == 1:
        go(rest[0])
    elif command == "ls":
        ls()
    elif command == "land":
        land(rest)
    elif command == "done" and len(rest) == 1:
        done(rest[0])
    elif command == "done" and rest[1:] == ["--checked"]:
        done(rest[0], checked=True)
    elif command == "resume" and len(rest) == 1:
        resume(rest[0])
    elif command == "move" and rest and rest[0] in HOSTS:
        move(rest[0], rest[1:])
    elif command == "msg" and len(rest) == 2:
        msg(*rest)
    elif command == "status" and rest and rest[0] in MARKS:
        status(rest[0])  # Codex's notify appends a JSON argument; it's ignored
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
